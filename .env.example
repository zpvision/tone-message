FINKOPER_HOST=127.0.0.1
FINKOPER_PORT=8000
FINKOPER_ENVIRONMENT=production
FINKOPER_INFERENCE_URL=http://127.0.0.1:11434
FINKOPER_MODEL_ID=gemma4:26b
FINKOPER_CONNECT_TIMEOUT_SECONDS=5
FINKOPER_REQUEST_TIMEOUT_SECONDS=120
FINKOPER_READINESS_TIMEOUT_SECONDS=2
FINKOPER_CABINET_ENABLED=true
FINKOPER_CABINET_DATA_DIR=/var/lib/finkoper-ai/cabinet
FINKOPER_OLLAMA_NUM_PARALLEL=1
FINKOPER_API_ENABLED=true
FINKOPER_API_DATA_DIR=/var/lib/finkoper-ai/api
FINKOPER_API_MAX_ITEMS=1000
FINKOPER_API_MAX_BODY_BYTES=5242880
FINKOPER_API_MAX_WAITING_BATCHES=5
FINKOPER_API_MAX_WAITING_MESSAGES=2000
FINKOPER_API_QUEUE_TIMEOUT=30
FINKOPER_API_DEADLINE=600
FINKOPER_API_INFERENCE_TIMEOUT=180
# Legacy reserved settings below are unused. Bearer secrets are managed by CLI,
# not FINKOPER_API_KEY; the server stores hashes only.
# FINKOPER_API_KEY=
# FINKOPER_MAX_BATCH_SIZE=
# FINKOPER_MAX_TEXT_CHARACTERS=
# FINKOPER_MAX_QUEUE_SIZE=
# FINKOPER_MAX_CONCURRENCY=
HF_HOME=/var/lib/finkoper-ai/huggingface
TORCH_HOME=/var/lib/finkoper-ai/torch
XDG_CACHE_HOME=/var/lib/finkoper-ai/cache
TMPDIR=/var/lib/finkoper-ai/tmp
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
# Shared inference; never downloads a model or selects another installed model.
FINKOPER_INFERENCE_BACKEND=ollama
# Optional digest pin: change with model_id after validating the intended model.
FINKOPER_MODEL_DIGEST=
FINKOPER_INFERENCE_KEEP_ALIVE=-1
FINKOPER_INFERENCE_CONCURRENCY=1
FINKOPER_INFERENCE_LOCK_DIR=/var/lib/finkoper-ai/gpu-locks
FINKOPER_INFERENCE_LOCK_TIMEOUT=30
FINKOPER_INFERENCE_RETRIES=1
FINKOPER_INFERENCE_RETRY_DELAY=0.2
FINKOPER_TOKENIZER_TIMEOUT=180
FINKOPER_TOKENIZER_DISCOVERY_TTL=30
# Sentiment profile. Existing limits above retain their meaning.
FINKOPER_API_NUM_CTX=8192
FINKOPER_SENTIMENT_MAX_OUTPUT=128
FINKOPER_SENTIMENT_TEMPERATURE=0
FINKOPER_SENTIMENT_THINKING=false
FINKOPER_SENTIMENT_WORKERS=1
# Historical wire alias only; NEVER used as inference model_id.
FINKOPER_API_MODEL_ALIAS=qwen3:8b
FINKOPER_API_MODEL_ALIASES=["gemma4:26b"]
FINKOPER_TASK_PRIORITIES={"sentiment":0,"morning_briefing":1,"assistant":1}
FINKOPER_TASK_AGING_SECONDS=10
# Optional future profiles reuse FINKOPER_MODEL_ID, no additional model copies.
FINKOPER_FUNCTION_PROFILES={}
